APP_ENV=production
# Leave empty if frontend and backend are on the same domain
ALLOWED_ORIGIN=
COMPANY_EMAIL=syvanta.official@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=syvanta.official@gmail.com
# Gmail App Password (16 chars; spaces are ignored)
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
# Optional: DB is optional. Submissions are always saved in storage/data/*.jsonl
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
# Set any secret to enable /api/index.php?r=health&key=SECRET&test=1 (sends a test email)
HEALTH_KEY=
